@@ -0,0 +1,147 @@
+// Synthetic loopback sites only: no provider credentials or database is used.
+// PLAYWRIGHT_PACKAGE_JSON selects an installed Playwright package's package.json.
+import assert from "node:assert/strict";
+import { AsyncLocalStorage } from "node:async_hooks";
+import { createRequire } from "node:module";
+import { join } from "node:path";
+import { createServer } from "node:http";
+import type { AddressInfo } from "node:net";
+import type { WorkStore } from "next/dist/server/app-render/work-async-storage.external";
+
+async function main() {
+  Object.defineProperty(globalThis, "AsyncLocalStorage", {
+    value: AsyncLocalStorage,
+    configurable: true,
+  });
+  process.env.DATABASE_URL = "postgresql://unused@127.0.0.1:1/synthetic_only";
+  process.env.SESSION_SECRET = "synthetic-cross-site-test-secret-at-least-32-characters";
+  const [
+    { NextRequest },
+    { createRequestStoreForAPI },
+    { workUnitAsyncStorage },
+    { workAsyncStorage },
+    { db },
+    { createAdminSession },
+    route,
+  ] = await Promise.all([
+    import("next/server"),
+    import("next/dist/server/async-storage/request-store.js"),
+    import("next/dist/server/app-render/work-unit-async-storage.external.js"),
+    import("next/dist/server/app-render/work-async-storage.external.js"),
+    import("../lib/db"),
+    import("../lib/auth"),
+    import("../app/api/integrations/receptionist/v1/[...path]/route"),
+  ]);
+  // Replace only the credential database boundary. Cookie signature validation,
+  // request cookie policy, the route, and approval HTML all remain real.
+  db.adminCredential.findUnique = (async () => ({
+    id: 1, passwordHash: null, sessionVersion: 0, updatedAt: new Date(),
+  })) as unknown as typeof db.adminCredential.findUnique;
+  db.$transaction = (() => {
+    throw Error("Authorization must wait for the administrator's approval POST");
+  }) as typeof db.$transaction;
+  const browserRequire = createRequire(
+    process.env.PLAYWRIGHT_PACKAGE_JSON ??
+      join(process.env.RUNNER_TEMP ?? "/tmp", "service-assignment-browser", "package.json"),
+  );
+  const { chromium } = browserRequire("playwright");
+
+  const requests: { site: string | undefined; adminCookie: boolean; status: number }[] = [];
+  let callbackVisited = false;
+  let repairOrigin = "", receptionistOrigin = "", authorizeUrl = "";
+  const server = createServer((incoming, outgoing) => {
+    void (async () => {
+      const url = new URL(incoming.url ?? "/", "http://" + incoming.headers.host);
+      if (url.pathname === "/favicon.ico") { outgoing.statusCode = 204; outgoing.end(); return; }
+      if (url.origin === receptionistOrigin) {
+        if (url.pathname === "/api/auth/callback") callbackVisited = true;
+        outgoing.setHeader("Content-Type", "text/html");
+        outgoing.end(`<a href="${authorizeUrl.replace(/&/g, "&amp;")}">Connect administrator</a>`);
+        return;
+      }
+      assert.equal(url.origin, repairOrigin, "all traffic must remain on loopback");
+      assert.equal(incoming.method, "GET", "authorization must wait for the approval POST");
+      const headers = new Headers();
+      for (const [name, value] of Object.entries(incoming.headers)) {
+        if (value !== undefined) headers.set(name, Array.isArray(value) ? value.join(", ") : value);
+      }
+      const request = new NextRequest(url.href, { headers });
+      let cookieUpdates: string[] = [];
+      const store = createRequestStoreForAPI(
+        request, { pathname: url.pathname }, { tags: [], expirationsByCacheKind: new Map() },
+        (cookies) => { cookieUpdates = cookies; }, undefined,
+      );
+      const response = await workAsyncStorage.run(
+        { route: url.pathname } as WorkStore,
+        () => workUnitAsyncStorage.run(store, () => route.GET(request, {
+          params: Promise.resolve({ path: ["authorize"] }),
+        })),
+      );
+      requests.push({
+        site: headers.get("sec-fetch-site") ?? undefined,
+        adminCookie: (headers.get("cookie") ?? "").includes("repair-admin="),
+        status: response.status,
+      });
+      outgoing.statusCode = response.status;
+      response.headers.forEach((value, name) => outgoing.setHeader(name, value));
+      if (cookieUpdates.length) outgoing.setHeader("Set-Cookie", cookieUpdates);
+      outgoing.end(await response.text());
+    })().catch((error) => { outgoing.statusCode = 500; outgoing.end("Synthetic test failed"); console.error(error); });
+  });
+  await new Promise<void>((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", resolve);
+  });
+  const port = (server.address() as AddressInfo).port;
+  repairOrigin = `http://127.0.0.1:${port}`;
+  receptionistOrigin = `http://localhost:${port}`;
+  process.env.RECEPTIONIST_ORIGIN = receptionistOrigin;
+  process.env.APP_URL = repairOrigin;
+  const query = {
+    redirect_uri: receptionistOrigin + "/api/auth/callback",
+    state: "s".repeat(32),
+    code_challenge: "p".repeat(43),
+  };
+  authorizeUrl = repairOrigin + "/api/integrations/receptionist/v1/authorize?" + new URLSearchParams(query);
+  let browser: any;
+  try {
+    browser = await chromium.launch({
+      headless: true,
+      ...(process.env.CHROMIUM_PATH ? { executablePath: process.env.CHROMIUM_PATH } : {}),
+      args: ["--no-sandbox"],
+    });
+    const context = await browser.newContext();
+    const token = createAdminSession(0);
+    await context.addCookies([{
+      name: "repair-admin", value: token, domain: "127.0.0.1", path: "/",
+      httpOnly: true, secure: false, sameSite: "Strict",
+    }]);
+    const page = await context.newPage();
+    await page.goto(receptionistOrigin);
+    await page.getByRole("link", { name: "Connect administrator" }).click();
+    assert.equal(requests[0]?.site, "cross-site");
+    assert.equal(requests[0]?.adminCookie, false, "Strict cookies must stay absent on cross-site arrival");
+    assert.equal(requests[0]?.status, 200, "cross-site arrival must render a public continuation");
+    assert.equal(await page.locator("form").count(), 0, "landing must not authorize the connection");
+    assert.equal(callbackVisited, false);
+    await page.getByRole("link", { name: "Continue to administrator approval" }).click();
+    assert.equal(requests[1]?.site, "same-origin");
+    assert.equal(requests[1]?.adminCookie, true, "same-origin continuation must carry the existing Strict cookie");
+    assert.equal(requests[1]?.status, 200);
+    assert.equal(await page.locator('form[method="post"]').count(), 1);
+    assert.equal(await page.getByRole("button", { name: "Connect admin account" }).count(), 1);
+    assert.ok(await page.locator('input[name="csrf"]').inputValue());
+    for (const [name, value] of Object.entries(query)) {
+      assert.equal(await page.locator(`input[name="${name}"]`).inputValue(), value);
+    }
+    assert.equal(callbackVisited, false, "administrator approval must precede the callback");
+    console.log("PASS cross-site landing omits Strict cookie; same-origin continuation sends it; explicit approval remains required.");
+  } finally {
+    await browser?.close();
+    server.closeAllConnections();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+    await db.$disconnect();
+  }
+}
+
+main().catch((error) => { console.error(error); process.exitCode = 1; });
