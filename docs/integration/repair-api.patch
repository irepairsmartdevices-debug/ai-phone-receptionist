@@ -0,0 +1,17 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {readdirSync,readFileSync} from 'node:fs';
+import {join} from 'node:path';
+import {migrations} from '../scripts/neon-sql';
+
+test('SQL bootstrap registers every Prisma migration with its exact executable bytes and checksum',()=>{
+ const directory='prisma/migrations';
+ const names=readdirSync(directory,{withFileTypes:true}).filter(entry=>entry.isDirectory()).map(entry=>entry.name).sort();
+ assert.deepEqual(migrations.map(migration=>migration.name),names,'A missing registry entry prevents SQL setup and repeat deployments from recognizing the Prisma migration.');
+ for(const migration of migrations){
+  const source=readFileSync(join(directory,migration.name,'migration.sql'),'utf8');
+  assert.equal(migration.sql,source);
+  assert.equal(migration.checksum,createHash('sha256').update(source).digest('hex'));
+ }
+});
