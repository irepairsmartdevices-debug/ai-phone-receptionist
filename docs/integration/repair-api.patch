+// Local integration test data only. Never runs against a remote/production database.
+import { createAdminSession } from "../lib/auth";
+import { writeFileSync } from "node:fs";
+import { randomInt, randomUUID } from "node:crypto";
+import { db } from "../lib/db";
+import { challenge, issueStaffGrant } from "../lib/receptionist/service";
+async function main() {
+  const url = new URL(process.env.DATABASE_URL ?? "");
+  if (
+    process.env.NODE_ENV === "production" ||
+    !["localhost", "127.0.0.1"].includes(url.hostname) ||
+    url.pathname !== "/repair_integration"
+  )
+    throw Error("Dedicated local integration database required");
+  const original = await db.appointment.findFirstOrThrow();
+  const { id, ticketNumber, ...data } = original;
+  void id;
+  void ticketNumber;
+  const ticket = await db.appointment.create({
+    data: {
+      ...data,
+      status: "CONFIRMED",
+      portalEligible: true,
+      portalPhone: "+1555" + String(randomInt(1000000, 9999999)),
+      customerId: null,
+      manageKey: null,
+    },
+  });
+  const credential = await db.adminCredential.findUniqueOrThrow({
+    where: { id: 1 },
+  });
+  const grant = await issueStaffGrant({
+    role: "ADMIN",
+    employeeId: null,
+    name: "Local Test Admin",
+    sessionVersion: credential.sessionVersion,
+    expires: Date.now() + 600000,
+  });
+  const conversationId = randomUUID();
+  let code = "";
+  const c = await challenge(
+    String(ticket.ticketNumber),
+    { conversationId, operationId: randomUUID() },
+    async (_phone, value) => {
+      code = value;
+    },
+  );
+  writeFileSync(
+    process.argv[2],
+    JSON.stringify({
+      reference: String(ticket.ticketNumber).padStart(4, "0"),
+      grant,
+      conversationId,
+      code,
+      challengeId: c.challengeId,
+      adminCookie: createAdminSession(credential.sessionVersion),
+    }),
+    { mode: 0o600 },
+  );
+}
+main().finally(() => db.$disconnect());
