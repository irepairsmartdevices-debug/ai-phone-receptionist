--- /dev/null
+++ b/lib/receptionist/auth.ts
@@ -0,0 +1,60 @@
+import { createHash, timingSafeEqual } from "node:crypto";
+export const digest = (s: string) =>
+  createHash("sha256").update(s).digest("hex");
+export const pkceDigest = (s: string) =>
+  createHash("sha256").update(s).digest("base64url");
+export function machineAuthorized(
+  header: string | null,
+  token = process.env.RECEPTIONIST_API_TOKEN ?? "",
+) {
+  if (!token || !header?.startsWith("Bearer ")) return false;
+  const a = Buffer.from(digest(header.slice(7))),
+    b = Buffer.from(digest(token));
+  return timingSafeEqual(a, b);
+}
+export function validRedirect(
+  uri: string,
+  origin = process.env.RECEPTIONIST_ORIGIN ?? "",
+) {
+  try {
+    const u = new URL(origin);
+    if (
+      u.protocol !== "https:" &&
+      !(
+        u.protocol === "http:" &&
+        ["localhost", "127.0.0.1"].includes(u.hostname)
+      )
+    )
+      return false;
+    return uri === u.origin + "/api/auth/callback";
+  } catch {
+    return false;
+  }
+}
+
+// Only call after validating the callback query. A cross-site arrival cannot
+// carry the repair app's Strict admin cookie; a user-initiated same-origin
+// navigation can, without changing that cookie's policy or authorizing anything.
+export function authorizationLanding(
+  request: Request,
+  query: { redirect_uri: string; state: string; code_challenge: string },
+) {
+  if (request.headers.get("sec-fetch-site") !== "cross-site") return null;
+  const continuation =
+    "/api/integrations/receptionist/v1/authorize?" + new URLSearchParams(query);
+  const safe = continuation.replace(/[&<>"']/g, (c) => ({
+    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
+  })[c]!);
+  return new Response(
+    `<!doctype html><html><head><meta charset="utf-8"><title>Continue to administrator approval</title></head><body><h1>Connect your receptionist</h1><p>Continue on this repair site to use your administrator session. You will review and approve the connection on the next page.</p><a href="${safe}">Continue to administrator approval</a></body></html>`,
+    {
+      headers: {
+        "Content-Type": "text/html; charset=utf-8",
+        "Cache-Control": "no-store",
+        "Content-Security-Policy": "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
+        "Referrer-Policy": "no-referrer",
+        "X-Content-Type-Options": "nosniff",
+      },
+    },
+  );
+}
diff --git a/lib/receptionist/service.ts b/lib/receptionist/service.ts
new file mode 100644
index 0000000..d0357db
--- /dev/null
+++ b/lib/receptionist/service.ts
@@ -0,0 +1,535 @@
+import {
+  createHash,
+  createHmac,
+  randomBytes,
+  randomInt,
+  randomUUID,
+} from "node:crypto";
+import { Prisma, type Appointment } from "@prisma/client";
+import { z } from "zod";
+import { db } from "../db";
+import {
+  withBookingTransaction,
+  reserve,
+  appointmentInclude,
+} from "../booking";
+import { assertRepairActor, type StaffActor } from "../staff-access";
+import { adminTicketVersion } from "../admin-ticket-version";
+import { takeCustomerRateLimits } from "../customer-auth-throttle";
+import { sendCustomerVerificationSms } from "../customer-verification-gateway";
+import { normalizeSmsPhone } from "../notification-contact";
+import { enqueueAppointmentNotifications } from "../notifications";
+import { digest } from "./auth";
+type Context = { conversationId: string; operationId: string };
+type Result<T> = { ok: true; value: T } | { ok: false; code: string };
+const yes = <T>(value: T): Result<T> => ({ ok: true, value });
+const no = (code: string): { ok: false; code: string } => ({ ok: false, code });
+const json = (value: unknown) =>
+  JSON.parse(JSON.stringify(value)) as Prisma.InputJsonValue;
+const challengeSchema = z.object({
+  reference: z.string(),
+  conversationId: z.string(),
+  hash: z.string(),
+  phone: z.string().nullable(),
+  attempts: z.number(),
+  delivered: z.boolean(),
+});
+const grantSchema = z.discriminatedUnion("type", [
+  z.object({
+    type: z.literal("customer"),
+    ticketId: z.string(),
+    conversationId: z.string(),
+    phone: z.string(),
+  }),
+  z.object({
+    type: z.literal("staff"),
+    actor: z.object({
+      role: z.enum(["ADMIN", "EMPLOYEE"]),
+      employeeId: z.string().nullable(),
+      name: z.string(),
+      sessionVersion: z.number(),
+      expires: z.number(),
+    }),
+  }),
+]);
+export async function issueStaffGrant(
+  actor: StaffActor,
+  tx: Prisma.TransactionClient = db,
+) {
+  const token = randomBytes(32).toString("hex");
+  await tx.receptionistRecord.create({
+    data: {
+      id: "grant:" + digest(token),
+      kind: "grant",
+      payload: json({ type: "staff", actor }),
+      expiresAt: new Date(Math.min(Date.now() + 900000, actor.expires ?? 0)),
+    },
+  });
+  return token;
+}
+async function readGrant(token: string, tx: Prisma.TransactionClient = db) {
+  const r = await tx.receptionistRecord.findUnique({
+    where: { id: "grant:" + digest(token) },
+  });
+  if (!r?.expiresAt || r.expiresAt <= new Date()) return null;
+  const parsed = grantSchema.safeParse(r.payload);
+  return parsed.success ? parsed.data : null;
+}
+export async function staff(
+  token: string,
+  tx: Prisma.TransactionClient = db,
+  locationId?: string,
+) {
+  const g = await readGrant(token, tx);
+  if (g?.type !== "staff") return null;
+  try {
+    await assertRepairActor(tx, g.actor);
+    if (
+      locationId &&
+      g.actor.role === "EMPLOYEE" &&
+      !(await tx.employeeLocation.findUnique({
+        where: {
+          employeeId_locationId: {
+            employeeId: g.actor.employeeId!,
+            locationId,
+          },
+        },
+      }))
+    )
+      return null;
+    return g.actor;
+  } catch {
+    return null;
+  }
+}
+const codeHash = (id: string, code: string) => {
+  const key = process.env.SESSION_SECRET;
+  if (!key || key.length < 32)
+    throw Error("Verification signing secret missing");
+  return createHmac("sha256", key)
+    .update(id + ":" + code)
+    .digest("hex");
+};
+export async function challenge(
+  reference: string,
+  context: Context,
+  deliver = sendCustomerVerificationSms,
+) {
+  const challengeId = randomUUID(),
+    code = String(randomInt(100000, 1000000));
+  const phone = await withBookingTransaction(async (tx) => {
+    const a = /^\d{1,10}$/.test(reference)
+      ? await tx.appointment.findUnique({
+          where: { ticketNumber: Number(reference) },
+        })
+      : null;
+    const phone = a?.portalEligible
+      ? normalizeSmsPhone(a.portalPhone ?? a.phone)
+      : null;
+    const allowed = await takeCustomerRateLimits(tx, [
+      {
+        scope: "receptionist-ticket",
+        value: reference,
+        windowMs: 900000,
+        max: 3,
+      },
+      {
+        scope: "receptionist-contact",
+        value: phone ?? "unknown",
+        windowMs: 900000,
+        max: 3,
+      },
+      {
+        scope: "receptionist-conversation",
+        value: context.conversationId,
+        windowMs: 900000,
+        max: 3,
+      },
+    ]);
+    await tx.receptionistRecord.create({
+      data: {
+        id: "challenge:" + challengeId,
+        kind: "challenge",
+        payload: json({
+          reference,
+          conversationId: context.conversationId,
+          hash: codeHash(challengeId, code),
+          phone: allowed ? phone : null,
+          attempts: 0,
+          delivered: false,
+        }),
+        expiresAt: new Date(Date.now() + 300000),
+      },
+    });
+    return allowed ? phone : null;
+  });
+  if (phone)
+    try {
+      await deliver(phone, code);
+      await withBookingTransaction(async (tx) => {
+        const row = await tx.receptionistRecord.findUniqueOrThrow({
+          where: { id: "challenge:" + challengeId },
+        });
+        const d = challengeSchema.parse(row.payload);
+        await tx.receptionistRecord.update({
+          where: { id: row.id },
+          data: { payload: json({ ...d, delivered: true }) },
+        });
+      });
+    } catch {
+      /* Generic response prevents enumeration and never returns provider errors. */
+    }
+  return { challengeId };
+}
+export async function verify(
+  challengeId: string,
+  code: string,
+  context: Context,
+): Promise<Result<{ grant: string }>> {
+  return withBookingTransaction(async (tx) => {
+    const r = await tx.receptionistRecord.findUnique({
+      where: { id: "challenge:" + challengeId },
+    });
+    if (!r?.expiresAt || r.expiresAt <= new Date()) return no("UNAUTHORIZED");
+    const c = challengeSchema.parse(r.payload);
+    await tx.receptionistRecord.update({
+      where: { id: r.id },
+      data: { payload: json({ ...c, attempts: c.attempts + 1 }) },
+    });
+    if (
+      !c.delivered ||
+      c.attempts >= 5 ||
+      c.conversationId !== context.conversationId ||
+      !/^\d{6}$/.test(code) ||
+      codeHash(challengeId, code) !== c.hash ||
+      !c.phone
+    )
+      return no("UNAUTHORIZED");
+    const a = await tx.appointment.findUnique({
+      where: { ticketNumber: Number(c.reference) },
+    });
+    if (
+      !a?.portalEligible ||
+      normalizeSmsPhone(a.portalPhone ?? a.phone) !== c.phone
+    )
+      return no("UNAUTHORIZED");
+    const grant = randomBytes(32).toString("hex");
+    await tx.receptionistRecord.create({
+      data: {
+        id: "grant:" + digest(grant),
+        kind: "grant",
+        payload: json({
+          type: "customer",
+          ticketId: a.id,
+          conversationId: c.conversationId,
+          phone: c.phone,
+        }),
+        expiresAt: new Date(Date.now() + 900000),
+      },
+    });
+    await tx.receptionistRecord.delete({ where: { id: r.id } });
+    return yes({ grant });
+  });
+}
+function safeTicket(
+  a: Appointment & {
+    location: { name: string };
+    offering: { model: { name: string }; service: { name: string } };
+  },
+) {
+  return {
+    reference: String(a.ticketNumber).padStart(4, "0"),
+    status: a.status,
+    version: adminTicketVersion(a),
+    device: a.offering.model.name,
+    service: a.offering.service.name,
+    location: a.location.name,
+  };
+}
+export async function ticket(
+  reference: string,
+  token: string,
+  conversationId: string,
+) {
+  return withBookingTransaction(async (tx) => {
+    if (!/^\d{1,10}$/.test(reference)) return no("INVALID");
+    const a = await tx.appointment.findUnique({
+      where: { ticketNumber: Number(reference) },
+      include: appointmentInclude,
+    });
+    if (!a) return no("NOT_FOUND");
+    const g = await readGrant(token, tx);
+    if (!g) return no("UNAUTHORIZED");
+    if (g.type === "staff") {
+      if (!(await staff(token, tx, a.locationId))) return no("UNAUTHORIZED");
+    } else if (
+      g.ticketId !== a.id ||
+      g.conversationId !== conversationId ||
+      !a.portalEligible ||
+      normalizeSmsPhone(a.portalPhone ?? a.phone) !== g.phone
+    )
+      return no("UNAUTHORIZED");
+    return yes(safeTicket(a));
+  });
+}
+const actionSchema = z
+  .object({
+    ticketReference: z.string().regex(/^\d{1,10}$/),
+    expectedVersion: z.string(),
+    targetStatus: z.literal("CANCELLED"),
+    confirmationId: z.string().min(1).max(200),
+  })
+  .strict();
+export async function changeStatus(
+  raw: unknown,
+  token: string,
+  context: Context,
+) {
+  const parsed = actionSchema.safeParse(raw);
+  if (!parsed.success) return no("INVALID");
+  const action = parsed.data,
+    identity = digest(token),
+    fingerprint = digest(
+      JSON.stringify({
+        action,
+        identity,
+        conversationId: context.conversationId,
+      }),
+    );
+  return withBookingTransaction(async (tx) => {
+    const actor = await staff(token, tx);
+    if (!actor) return no("UNAUTHORIZED");
+    const existing = await tx.receptionistRecord.findUnique({
+      where: { id: "operation:" + context.operationId },
+    });
+    if (existing) {
+      const data = existing.payload as { fingerprint: string; result: unknown };
+      return data.fingerprint === fingerprint
+        ? (data.result as ReturnType<typeof yes>)
+        : no("CONFLICT");
+    }
+    const a = await tx.appointment.findUnique({
+      where: { ticketNumber: Number(action.ticketReference) },
+      include: appointmentInclude,
+    });
+    let result: Result<unknown>;
+    if (!a) result = no("NOT_FOUND");
+    else if (!(await staff(token, tx, a.locationId)))
+      result = no("UNAUTHORIZED");
+    else if (adminTicketVersion(a) !== action.expectedVersion)
+      result = no("STALE");
+    else if (!["CONFIRMED", "IN_PROGRESS"].includes(a.status))
+      result = no("INVALID");
+    else {
+      const updated = await tx.appointment.update({
+        where: { id: a.id },
+        data: { status: "CANCELLED", notificationRevision: { increment: 1 } },
+        include: appointmentInclude,
+      });
+      await enqueueAppointmentNotifications(tx, updated, "CANCELLED", a);
+      result = yes(safeTicket(updated));
+    }
+    await tx.receptionistRecord.create({
+      data: {
+        id: "operation:" + context.operationId,
+        kind: "operation",
+        payload: json({
+          fingerprint,
+          identity,
+          conversationId: context.conversationId,
+          result,
+          actor: { role: actor.role, employeeId: actor.employeeId },
+          ticketReference: action.ticketReference,
+          oldStatus: a?.status ?? null,
+          targetStatus: "CANCELLED",
+          confirmationId: action.confirmationId,
+          at: new Date().toISOString(),
+        }),
+      },
+    });
+    return result;
+  });
+}
+export async function operation(operationId: string) {
+  const row = await db.receptionistRecord.findUnique({
+    where: { id: "operation:" + operationId },
+  });
+  if (!row) return no("NOT_FOUND");
+  const p = row.payload as { result: Result<{ reference: string }> };
+  return yes({
+    state: p.result.ok ? "succeeded" : "failed",
+    ...(p.result.ok ? { reference: p.result.value.reference } : {}),
+  });
+}
+export async function business() {
+  const [locations, offerings, questions] = await Promise.all([
+    db.location.findMany({
+      where: { enabled: true },
+      include: { businessHours: true },
+    }),
+    db.offering.findMany({
+      include: {
+        model: { include: { brand: { include: { category: true } } } },
+        service: true,
+      },
+    }),
+    db.preRepairQuestion.findMany({
+      where: { enabled: true, archived: false },
+      orderBy: [{ sortOrder: "asc" }, { id: "asc" }],
+    }),
+  ]);
+  const intakeRevision = digest(
+    JSON.stringify(questions.map((q) => [q.id, q.updatedAt.toISOString()])),
+  );
+  return {
+    name: "Repair Studio",
+    profile:
+      "Prices are estimates; final cost requires shop confirmation. No completion time is promised.",
+    locations: locations.map((l) => ({
+      id: l.id,
+      name: l.name,
+      address: l.address,
+      timeZone: l.timeZone,
+      hours: l.businessHours
+        .map(
+          (h) =>
+            `${["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][h.day]}: ${h.enabled ? `${Math.floor(h.open / 60)}:${String(h.open % 60).padStart(2, "0")}–${Math.floor(h.close / 60)}:${String(h.close % 60).padStart(2, "0")}` : "closed"}`,
+        )
+        .join(", "),
+    })),
+    offerings: offerings.map((o) => ({
+      id: o.id,
+      device: o.model.name,
+      categoryId: o.model.brand.categoryId,
+      category: o.model.brand.category.name,
+      brandId: o.model.brandId,
+      brand: o.model.brand.name,
+      modelId: o.modelId,
+      model: o.model.name,
+      serviceId: o.serviceId,
+      service: o.service.name,
+      price: o.price / 100,
+      duration: o.duration,
+    })),
+    intakeRevision,
+    questions: questions.map((q) => ({
+      id: q.id,
+      text: q.question,
+      version: q.updatedAt.toISOString(),
+      offeringIds: offerings
+        .filter((o) => o.model.brand.categoryId === q.categoryId)
+        .map((o) => o.id),
+    })),
+  };
+}
+const bookingSchema = z
+  .object({
+    locationId: z.string(),
+    offeringId: z.string(),
+    start: z.string().datetime({ offset: true }),
+    firstName: z.string().min(1).max(80),
+    lastName: z.string().max(80),
+    email: z.string().email(),
+    phone: z.string(),
+    issue: z.string().min(1).max(3000),
+    intakeRevision: z.string(),
+    answers: z.record(z.boolean()),
+    smsConsent: z.boolean(),
+    confirmationId: z.string().min(1),
+  })
+  .strict();
+export async function book(raw: unknown, context: Context) {
+  const parsed = bookingSchema.safeParse(raw);
+  if (!parsed.success) return no("INVALID");
+  const input = parsed.data,
+    phone = normalizeSmsPhone(input.phone);
+  if (!phone) return no("INVALID");
+  const fingerprint = digest(
+    JSON.stringify({ input, conversationId: context.conversationId }),
+  );
+  const previous = await db.receptionistRecord.findUnique({
+    where: { id: "operation:" + context.operationId },
+  });
+  if (previous) {
+    const p = previous.payload as {
+      fingerprint: string;
+      result: Result<{ reference: string }>;
+    };
+    return p.fingerprint === fingerprint ? p.result : no("CONFLICT");
+  }
+  const snapshot = await business();
+  if (snapshot.intakeRevision !== input.intakeRevision) return no("STALE");
+  try {
+    const row = await reserve(
+      {
+        locationId: input.locationId,
+        offeringId: input.offeringId,
+        start: new Date(input.start).toISOString(),
+        firstName: input.firstName,
+        lastName: input.lastName,
+        email: input.email,
+        phone,
+        notes: input.issue,
+        smsConsent: input.smsConsent,
+        preRepairAnswers: snapshot.questions
+          .filter(
+            (q) =>
+              q.offeringIds.includes(input.offeringId) &&
+              input.answers[q.id] !== undefined,
+          )
+          .map((q) => ({
+            questionId: q.id,
+            answer: input.answers[q.id],
+            questionVersion: q.version,
+          })),
+      },
+      undefined,
+      {
+        integration: {
+          before: async (tx) => {
+            const old = await tx.receptionistRecord.findUnique({
+              where: { id: "operation:" + context.operationId },
+            });
+            if (!old) return undefined;
+            const p = old.payload as {
+              fingerprint: string;
+              appointmentId: string;
+            };
+            if (p.fingerprint !== fingerprint)
+              throw Error("IDEMPOTENCY_CONFLICT");
+            return tx.appointment.findUniqueOrThrow({
+              where: { id: p.appointmentId },
+              include: appointmentInclude,
+            });
+          },
+          after: async (tx, a) => {
+            await tx.receptionistRecord.create({
+              data: {
+                id: "operation:" + context.operationId,
+                kind: "operation",
+                payload: json({
+                  fingerprint,
+                  appointmentId: a.id,
+                  conversationId: context.conversationId,
+                  result: yes({
+                    reference: String(a.ticketNumber).padStart(4, "0"),
+                  }),
+                  kind: "BOOKING",
+                  confirmationId: input.confirmationId,
+                  at: new Date().toISOString(),
+                }),
+              },
+            });
+          },
+        },
+      },
+    );
+    return yes({ reference: String(row.ticketNumber).padStart(4, "0") });
+  } catch (e) {
+    return no(
+      e instanceof Error && e.message === "IDEMPOTENCY_CONFLICT"
+        ? "CONFLICT"
+        : "INVALID",
+    );
+  }
+}
