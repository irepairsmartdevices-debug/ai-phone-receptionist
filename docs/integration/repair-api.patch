diff --git a/scripts/neon-sql-qa.ts b/scripts/neon-sql-qa.ts
new file mode 100644
index 0000000..a0ad7cd
--- /dev/null
+++ b/scripts/neon-sql-qa.ts
@@ -0,0 +1,102 @@
+// Run: node --import tsx --import dotenv/config --test scripts/neon-sql-qa.ts
+// Creates and drops only its own database on the dedicated local PostgreSQL port.
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash,randomUUID} from 'node:crypto';
+import {readFileSync,readdirSync} from 'node:fs';
+import {createRequire} from 'node:module';
+import {join} from 'node:path';
+import {migrationBootstrap} from './neon-sql';
+
+const {Client}=createRequire(import.meta.url)('pg');
+const receptionistMigration='20261023010000_receptionist_integration';
+const migrationNames=readdirSync('prisma/migrations',{withFileTypes:true}).filter(entry=>entry.isDirectory()).map(entry=>entry.name).sort();
+const upgradeSql=readFileSync('prisma/neon-locations-upgrade.sql','utf8');
+const setupSql=readFileSync('prisma/neon-setup.sql','utf8');
+
+test('generated SQL supports receptionist migration history and validates its schema',async t=>{
+ const url=new URL(process.env.DATABASE_URL??'');
+ assert(url.hostname==='127.0.0.1'&&url.port==='55432'&&process.env.NODE_ENV!=='production','SQL verification requires dedicated local PostgreSQL at 127.0.0.1:55432.');
+ const database='neon_sql_qa_'+randomUUID().replaceAll('-','');
+ url.pathname='/postgres';
+ const admin=new Client({connectionString:url.toString(),connectionTimeoutMillis:10000});
+ await admin.connect();
+ let created=false,connected=false;
+ url.pathname='/'+database;
+ const db=new Client({connectionString:url.toString(),connectionTimeoutMillis:10000});
+ const table=async()=> (await db.query(`SELECT to_regclass('public."ReceptionistRecord"')::text AS name`)).rows[0].name;
+ const ledger=async()=> (await db.query('SELECT migration_name,checksum,finished_at,started_at,applied_steps_count FROM "_prisma_migrations" ORDER BY migration_name')).rows;
+ const records=async()=> (await db.query('SELECT * FROM "ReceptionistRecord" ORDER BY id')).rows;
+ async function fixture(includeReceptionist:boolean){
+  await db.query('ROLLBACK');
+  await db.query('DROP SCHEMA public CASCADE; CREATE SCHEMA public');
+  await db.query(`CREATE TABLE "_prisma_migrations" (
+   id VARCHAR(36) PRIMARY KEY, checksum VARCHAR(64) NOT NULL, finished_at TIMESTAMPTZ,
+   migration_name VARCHAR(255) NOT NULL, logs TEXT, rolled_back_at TIMESTAMPTZ,
+   started_at TIMESTAMPTZ NOT NULL DEFAULT now(), applied_steps_count INTEGER NOT NULL DEFAULT 0
+  )`);
+  for(const name of migrationNames.filter(name=>includeReceptionist||name<receptionistMigration)){
+   const sql=readFileSync(join('prisma/migrations',name,'migration.sql'),'utf8');
+   await db.query(sql);
+   await db.query('INSERT INTO "_prisma_migrations" (id,checksum,finished_at,migration_name,applied_steps_count) VALUES ($1,$2,now(),$3,1)',[randomUUID(),createHash('sha256').update(sql).digest('hex'),name]);
+  }
+ }
+ try{
+  await admin.query(`CREATE DATABASE "${database}"`);created=true;
+  await db.connect();connected=true;
+  await t.test('upgrade creates the absent receptionist table from customer portal history and reruns twice',async()=>{
+   await fixture(false);
+   assert.equal((await ledger()).length,11);
+   assert.equal(await table(),null);
+   await db.query(upgradeSql);
+   assert.equal(await table(),'"ReceptionistRecord"','The production upgrade must apply the receptionist migration.');
+   assert.equal((await ledger()).length,12);
+   const before=await ledger();
+   for(let run=0;run<2;run++){
+    await db.query(upgradeSql);
+    assert.deepEqual(await ledger(),before,'Reruns must retain exactly one completed record for each migration.');
+   }
+  });
+  await t.test('both bootstrap modes accept independently tracked twelve-migration history and preserve records',async()=>{
+   await fixture(true);
+   assert.equal((await ledger()).length,12);
+   await db.query(`INSERT INTO "ReceptionistRecord" (id,kind,payload,"expiresAt") VALUES ('qa-record','grant','{"sessionVersion":7}',TIMESTAMP '2030-01-02 03:04:05')`);
+   const before=await ledger(),recordBefore=await records();
+   for(const sql of [migrationBootstrap('upgrade')+'COMMIT;',migrationBootstrap('full')+'COMMIT;',upgradeSql,setupSql]){
+    for(let run=0;run<2;run++){
+     await db.query(sql);
+     assert.deepEqual(await ledger(),before);
+     assert.deepEqual(await records(),recordBefore,'Bootstrap reruns must preserve receptionist payloads and expiry.');
+    }
+   }
+  });
+  await t.test('tracked stage twelve rejects a missing or partial receptionist table without changing history',async()=>{
+   for(const mode of ['full','upgrade'] as const){
+    for(const damage of ['DROP TABLE "ReceptionistRecord"','ALTER TABLE "ReceptionistRecord" DROP COLUMN "expiresAt"']){
+     await fixture(true);
+     await db.query(damage);
+     const before=await ledger();
+     await assert.rejects(db.query(migrationBootstrap(mode)+'COMMIT;'),/application schema is missing, partial, or unexpected/);
+     await db.query('ROLLBACK');
+     assert.deepEqual(await ledger(),before);
+    }
+   }
+  });
+  await t.test('fresh generated setup creates receptionist storage without seeding private records',async()=>{
+   await db.query('ROLLBACK');
+   await db.query('DROP SCHEMA public CASCADE; CREATE SCHEMA public');
+   await db.query(setupSql);
+   assert.equal(await table(),'"ReceptionistRecord"');
+   assert.equal((await ledger()).length,12);
+   assert.deepEqual(await records(),[]);
+   const before=await ledger();
+   await db.query(setupSql);
+   assert.deepEqual(await ledger(),before);
+   assert.deepEqual(await records(),[]);
+  });
+ }finally{
+  if(connected)await db.end();
+  if(created)await admin.query(`DROP DATABASE "${database}"`);
+  await admin.end();
+ }
+});
