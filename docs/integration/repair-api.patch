diff --git a/app/api/integrations/receptionist/v1/[...path]/route.ts b/app/api/integrations/receptionist/v1/[...path]/route.ts
new file mode 100644
index 0000000..de5bdc3
--- /dev/null
+++ b/app/api/integrations/receptionist/v1/[...path]/route.ts
@@ -0,0 +1,289 @@
+import { NextRequest, NextResponse } from "next/server";
+import { randomBytes, randomUUID } from "node:crypto";
+import { cookies } from "next/headers";
+import { z } from "zod";
+import { Prisma } from "@prisma/client";
+import { db } from "@/lib/db";
+import { requireRepairActor, assertRepairActor } from "@/lib/staff-access";
+import { withBookingTransaction, slots } from "@/lib/booking";
+import {
+  digest,
+  machineAuthorized,
+  validRedirect,
+  pkceDigest,
+  authorizationLanding,
+} from "@/lib/receptionist/auth";
+import * as service from "@/lib/receptionist/service";
+import { after } from "next/server";
+import { flushAppointmentNotifications } from "@/lib/notifications";
+export const dynamic = "force-dynamic";
+const contextSchema = z
+  .object({
+    conversationId: z.string().min(1).max(100),
+    operationId: z.string().min(1).max(100),
+  })
+  .strict();
+const json = (data: unknown) =>
+  JSON.parse(JSON.stringify(data)) as Prisma.InputJsonValue;
+const response = (data: unknown, status = 200) =>
+  NextResponse.json(data, {
+    status,
+    headers: {
+      "Cache-Control": "private, no-store",
+      "X-Content-Type-Options": "nosniff",
+    },
+  });
+const fail = (code: string, status = 400) =>
+  response({ ok: false, code }, status);
+function auth(request: Request) {
+  return machineAuthorized(request.headers.get("authorization"));
+}
+function callbackQuery(request: NextRequest) {
+  return z
+    .object({
+      redirect_uri: z.string(),
+      state: z.string().min(32).max(200),
+      code_challenge: z.string().regex(/^[A-Za-z0-9_-]{43}$/),
+    })
+    .parse(Object.fromEntries(request.nextUrl.searchParams));
+}
+export async function GET(
+  request: NextRequest,
+  { params }: { params: Promise<{ path: string[] }> },
+) {
+  try {
+    const path = (await params).path.join("/");
+    if (path === "authorize") {
+      const q = callbackQuery(request);
+      if (!validRedirect(q.redirect_uri)) return fail("INVALID");
+      const landing = authorizationLanding(request, q);
+      if (landing) return landing;
+      await requireRepairActor();
+      const csrf = randomBytes(32).toString("hex");
+      (await cookies()).set("receptionist_authorize", csrf, {
+        httpOnly: true,
+        sameSite: "strict",
+        secure: request.nextUrl.protocol === "https:",
+        maxAge: 300,
+        path: "/api/integrations/receptionist/v1/authorize",
+      });
+      const safe = (s: string) =>
+        s.replace(
+          /[&<>"']/g,
+          (c) =>
+            ({
+              "&": "&amp;",
+              "<": "&lt;",
+              ">": "&gt;",
+              '"': "&quot;",
+              "'": "&#39;",
+            })[c]!,
+        );
+      return new Response(
+        `<!doctype html><html><head><title>Connect receptionist</title></head><body><h1>Connect your admin account?</h1><p>The receptionist can read permitted tickets and request confirmed cancellations. Intake and checkout stay in this repair app.</p><form method="post"><input type="hidden" name="csrf" value="${csrf}"/>${Object.entries(
+          q,
+        )
+          .map(
+            ([k, v]) => `<input type="hidden" name="${k}" value="${safe(v)}"/>`,
+          )
+          .join(
+            "",
+          )}<button>Connect admin account</button></form></body></html>`,
+        {
+          headers: {
+            "Content-Type": "text/html",
+            "Cache-Control": "no-store",
+            "Content-Security-Policy": `default-src 'none'; form-action 'self' ${new URL(process.env.RECEPTIONIST_ORIGIN!).origin}; frame-ancestors 'none'`,
+          },
+        },
+      );
+    }
+    if (!auth(request)) return fail("UNAUTHORIZED", 401);
+    const p = request.nextUrl.searchParams;
+    if (path === "business")
+      return response({ ok: true, value: await service.business() });
+    if (path === "slots") {
+      const offering = await db.offering.findUnique({
+        where: { id: p.get("offeringId") ?? "" },
+      });
+      if (!offering) return fail("INVALID");
+      const locationId = p.get("locationId") ?? "";
+      return response({
+        ok: true,
+        value: (
+          await slots(p.get("date") ?? "", offering.duration, locationId)
+        ).map((start) => ({ start, locationId, offeringId: offering.id })),
+      });
+    }
+    if (path === "tickets")
+      return response(
+        await service.ticket(
+          p.get("reference") ?? "",
+          request.headers.get("x-receptionist-grant") ?? "",
+          p.get("conversationId") ?? "",
+        ),
+      );
+    if (path === "session") {
+      const actor = await service.staff(
+        request.headers.get("x-receptionist-grant") ?? "",
+      );
+      return actor
+        ? response({
+            ok: true,
+            value: { role: actor.role === "ADMIN" ? "admin" : "staff" },
+          })
+        : fail("UNAUTHORIZED", 401);
+    }
+    if (path.startsWith("operations/"))
+      return response(await service.operation(path.split("/")[1]));
+    return fail("NOT_FOUND", 404);
+  } catch {
+    return fail("UNAUTHORIZED", 401);
+  }
+}
+export async function POST(
+  request: NextRequest,
+  { params }: { params: Promise<{ path: string[] }> },
+) {
+  try {
+    const path = (await params).path.join("/");
+    if (path === "authorize") {
+      const origin = process.env.APP_URL;
+      if (!origin || request.headers.get("origin") !== new URL(origin).origin)
+        return fail("UNAUTHORIZED", 403);
+      const form = await request.formData(),
+        jar = await cookies(),
+        csrf = form.get("csrf");
+      if (
+        typeof csrf !== "string" ||
+        csrf !== jar.get("receptionist_authorize")?.value
+      )
+        return fail("UNAUTHORIZED", 403);
+      const q = z
+        .object({
+          redirect_uri: z.string(),
+          state: z.string().min(32).max(200),
+          code_challenge: z.string().regex(/^[\w-]{43}$/),
+        })
+        .parse(Object.fromEntries(form));
+      if (!validRedirect(q.redirect_uri)) return fail("INVALID");
+      const actor = await requireRepairActor(),
+        code = randomBytes(32).toString("hex");
+      await withBookingTransaction(async (tx) => {
+        await assertRepairActor(tx, actor);
+        await tx.receptionistRecord.create({
+          data: {
+            id: "code:" + digest(code),
+            kind: "authorization",
+            payload: json({
+              actor,
+              redirectUri: q.redirect_uri,
+              challenge: q.code_challenge,
+            }),
+            expiresAt: new Date(Date.now() + 300000),
+          },
+        });
+      });
+      jar.delete("receptionist_authorize");
+      const target = new URL(q.redirect_uri);
+      target.searchParams.set("code", code);
+      target.searchParams.set("state", q.state);
+      return NextResponse.redirect(target, 303);
+    }
+    if (!auth(request)) return fail("UNAUTHORIZED", 401);
+    const raw = await request.json();
+    if (path === "token") {
+      const b = z
+        .object({
+          code: z.string(),
+          verifier: z.string().min(43).max(128),
+          redirectUri: z.string(),
+        })
+        .strict()
+        .parse(raw);
+      const result = await withBookingTransaction(async (tx) => {
+        const row = await tx.receptionistRecord.findUnique({
+          where: { id: "code:" + digest(b.code) },
+        });
+        if (!row?.expiresAt || row.expiresAt <= new Date()) return null;
+        const p = row.payload as {
+          actor: Parameters<typeof service.issueStaffGrant>[0];
+          redirectUri: string;
+          challenge: string;
+        };
+        if (
+          !validRedirect(b.redirectUri) ||
+          p.redirectUri !== b.redirectUri ||
+          pkceDigest(b.verifier) !== p.challenge
+        )
+          return null;
+        await assertRepairActor(tx, p.actor);
+        await tx.receptionistRecord.delete({ where: { id: row.id } });
+        return {
+          grant: await service.issueStaffGrant(p.actor, tx),
+          role: p.actor.role === "ADMIN" ? "admin" : "staff",
+        };
+      });
+      return result
+        ? response({ ok: true, value: result })
+        : fail("UNAUTHORIZED", 401);
+    }
+    const { context, ...body } = z
+      .object({ context: contextSchema })
+      .passthrough()
+      .parse(raw);
+    if (path === "challenges") {
+      const b = z
+        .object({ reference: z.string().regex(/^\d{1,10}$/) })
+        .strict()
+        .parse(body);
+      return response({
+        ok: true,
+        value: await service.challenge(b.reference, context),
+      });
+    }
+    if (path === "verify") {
+      const b = z
+        .object({
+          challengeId: z.string().uuid(),
+          code: z.string().regex(/^\d{6}$/),
+        })
+        .strict()
+        .parse(body);
+      return response(await service.verify(b.challengeId, b.code, context));
+    }
+    if (path === "bookings") {
+      const r = await service.book(body, context);
+      if (r.ok)
+        after(async () => {
+          const a = await db.appointment.findUnique({
+            where: { ticketNumber: Number(r.value.reference) },
+          });
+          if (a) await flushAppointmentNotifications(a.id).catch(() => {});
+        });
+      return response(r);
+    }
+    if (path === "actions") {
+      const r = await service.changeStatus(
+        body,
+        request.headers.get("x-receptionist-grant") ?? "",
+        context,
+      );
+      if (r.ok)
+        after(async () => {
+          const a = await db.appointment.findUnique({
+            where: {
+              ticketNumber: Number(
+                (r.value as { reference: string }).reference,
+              ),
+            },
+          });
+          if (a) await flushAppointmentNotifications(a.id).catch(() => {});
+        });
+      return response(r);
+    }
+    return fail("NOT_FOUND", 404);
+  } catch {
+    return fail("INVALID");
+  }
+}
