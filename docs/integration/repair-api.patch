@@ -0,0 +1,36 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  machineAuthorized,
+  pkceDigest,
+  validRedirect,
+} from "./receptionist/auth";
+test("machine credential uses dedicated token and rejects absent or malformed authorization", () => {
+  assert.equal(machineAuthorized("Bearer abc", "abc"), true);
+  assert.equal(machineAuthorized("Bearer abc", ""), false);
+  assert.equal(machineAuthorized("Bearer abcd", "abc"), false);
+});
+test("authorization callbacks are exact allowlisted URLs and PKCE is stable", () => {
+  assert.equal(
+    validRedirect(
+      "http://localhost:3000/api/auth/callback",
+      "http://localhost:3000",
+    ),
+    true,
+  );
+  assert.equal(
+    validRedirect(
+      "https://evil.example/api/auth/callback",
+      "http://localhost:3000",
+    ),
+    false,
+  );
+  assert.equal(
+    validRedirect(
+      "http://localhost:3000/api/auth/callback?evil=1",
+      "http://localhost:3000",
+    ),
+    false,
+  );
+  assert.match(pkceDigest("a".repeat(43)), /^[\w-]{43}$/);
+});
