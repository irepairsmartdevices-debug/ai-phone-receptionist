@@ -0,0 +1,140 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { AsyncLocalStorage } from "node:async_hooks";
+import type { WorkStore } from "next/dist/server/app-render/work-async-storage.external";
+import {
+  machineAuthorized,
+  pkceDigest,
+  validRedirect,
+} from "./receptionist/auth";
+Object.defineProperty(globalThis, "AsyncLocalStorage", {
+  value: AsyncLocalStorage,
+  configurable: true,
+});
+test("machine credential uses dedicated token and rejects absent or malformed authorization", () => {
+  assert.equal(machineAuthorized("Bearer abc", "abc"), true);
+  assert.equal(machineAuthorized("Bearer abc", ""), false);
+  assert.equal(machineAuthorized("Bearer abcd", "abc"), false);
+});
+test("authorization callbacks are exact allowlisted URLs and PKCE is stable", () => {
+  assert.equal(
+    validRedirect(
+      "http://localhost:3000/api/auth/callback",
+      "http://localhost:3000",
+    ),
+    true,
+  );
+  assert.equal(
+    validRedirect(
+      "https://evil.example/api/auth/callback",
+      "http://localhost:3000",
+    ),
+    false,
+  );
+  assert.equal(
+    validRedirect(
+      "http://localhost:3000/api/auth/callback?evil=1",
+      "http://localhost:3000",
+    ),
+    false,
+  );
+  assert.match(pkceDigest("a".repeat(43)), /^[\w-]{43}$/);
+});
+
+const authorizationQuery = {
+  redirect_uri: "https://receptionist.test/api/auth/callback",
+  state: "a".repeat(32),
+  code_challenge: "b".repeat(43),
+};
+async function authorize(
+  fetchSite: string | undefined,
+  query = authorizationQuery,
+) {
+  const [
+    { NextRequest },
+    { createRequestStoreForAPI },
+    { workUnitAsyncStorage },
+    { workAsyncStorage },
+    route,
+  ] = await Promise.all([
+    import("next/server"),
+    import("next/dist/server/async-storage/request-store.js"),
+    import("next/dist/server/app-render/work-unit-async-storage.external.js"),
+    import("next/dist/server/app-render/work-async-storage.external.js"),
+    import("../app/api/integrations/receptionist/v1/[...path]/route"),
+  ]);
+  const pathname = "/api/integrations/receptionist/v1/authorize";
+  const request = new NextRequest(
+    "https://repair.test" + pathname + "?" + new URLSearchParams(query),
+    { headers: fetchSite ? { "sec-fetch-site": fetchSite } : {} },
+  );
+  const store = createRequestStoreForAPI(
+    request,
+    { pathname },
+    { tags: [], expirationsByCacheKind: new Map() },
+    undefined,
+    undefined,
+  );
+  const originalOrigin = process.env.RECEPTIONIST_ORIGIN;
+  process.env.RECEPTIONIST_ORIGIN = "https://receptionist.test";
+  try {
+    const response = await workAsyncStorage.run(
+      { route: pathname } as WorkStore,
+      () => workUnitAsyncStorage.run(store, () => route.GET(request, {
+        params: Promise.resolve({ path: ["authorize"] }),
+      })),
+    );
+    return { response, cookies: store.mutableCookies.getAll() };
+  } finally {
+    if (originalOrigin === undefined) delete process.env.RECEPTIONIST_ORIGIN;
+    else process.env.RECEPTIONIST_ORIGIN = originalOrigin;
+  }
+}
+
+test("cross-site authorization offers a same-origin continuation before requiring the Strict admin cookie", async () => {
+  const { response, cookies } = await authorize("cross-site");
+  assert.equal(response.status, 200);
+  assert.match(response.headers.get("content-type") ?? "", /text\/html/);
+  assert.match(response.headers.get("cache-control") ?? "", /no-store/);
+  assert.match(response.headers.get("content-security-policy") ?? "", /default-src 'none'/);
+  assert.match(response.headers.get("content-security-policy") ?? "", /frame-ancestors 'none'/);
+  assert.equal(response.headers.get("location"), null);
+  assert.deepEqual(cookies, [], "the public landing must not create an authorization session");
+  const html = await response.text();
+  const href = html.match(/<a href="([^"]+)"/i)?.[1].replace(/&amp;/g, "&");
+  assert.ok(href);
+  assert.ok(href.startsWith("/api/integrations/receptionist/v1/authorize?"));
+  const continuation = new URL(href, "https://repair.test");
+  assert.equal(continuation.origin, "https://repair.test");
+  assert.deepEqual(Object.fromEntries(continuation.searchParams), authorizationQuery);
+  assert.doesNotMatch(html, /<form|<script|http-equiv=["']?refresh/i);
+});
+
+test("authorization continuation preserves state safely without adding HTML or extra query fields", async () => {
+  const query = { ...authorizationQuery, state: "a".repeat(32) + '&"><script>alert(1)</script>' };
+  const { response } = await authorize("cross-site", query);
+  assert.equal(response.status, 200);
+  const html = await response.text();
+  assert.doesNotMatch(html, /<script|<form/i);
+  const href = html.match(/<a href="([^"]+)"/i)?.[1].replace(/&amp;/g, "&");
+  assert.ok(href);
+  assert.deepEqual(Object.fromEntries(new URL(href, "https://repair.test").searchParams), query);
+});
+
+test("cross-site landing still rejects a callback outside the exact allowlist", async () => {
+  const { response } = await authorize("cross-site", {
+    ...authorizationQuery,
+    redirect_uri: "https://evil.test/api/auth/callback",
+  });
+  assert.equal(response.status, 400);
+  assert.deepEqual(await response.json(), { ok: false, code: "INVALID" });
+});
+
+test("same-origin and headerless authorization still require an authenticated repair account", async () => {
+  for (const fetchSite of ["same-origin", undefined]) {
+    const { response, cookies } = await authorize(fetchSite);
+    assert.equal(response.status, 401);
+    assert.deepEqual(await response.json(), { ok: false, code: "UNAUTHORIZED" });
+    assert.deepEqual(cookies, []);
+  }
+});
