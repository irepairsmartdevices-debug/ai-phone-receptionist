+import test from "node:test";
+import assert from "node:assert/strict";
+import { business } from "./receptionist/service";
+import { db } from "./db";
+
+test("receptionist catalog exposes exact category, brand, model and repair identity without changing price units", async () => {
+  const source = await db.offering.findMany({
+    include: {
+      model: { include: { brand: { include: { category: true } } } },
+      service: true,
+    },
+  });
+  assert.ok(
+    source.length,
+    "dedicated integration database must have catalog fixture data",
+  );
+  const snapshot = await business();
+  assert.equal(snapshot.offerings.length, source.length);
+  for (const original of source) {
+    const offering = snapshot.offerings.find(
+      (item) => item.id === original.id,
+    )!;
+    assert.ok(offering);
+    assert.deepEqual(
+      {
+        categoryId: offering.categoryId,
+        category: offering.category,
+        brandId: offering.brandId,
+        brand: offering.brand,
+        modelId: offering.modelId,
+        model: offering.model,
+        serviceId: offering.serviceId,
+      },
+      {
+        categoryId: original.model.brand.categoryId,
+        category: original.model.brand.category.name,
+        brandId: original.model.brandId,
+        brand: original.model.brand.name,
+        modelId: original.modelId,
+        model: original.model.name,
+        serviceId: original.serviceId,
+      },
+    );
+    assert.equal(offering.device, original.model.name);
+    assert.equal(offering.service, original.service.name);
+    assert.equal(offering.price, original.price / 100);
+    assert.equal(offering.duration, original.duration);
+  }
+});
