+import test from "node:test";
+import { randomInt } from "node:crypto";
+import assert from "node:assert/strict";
+import {
+  challenge,
+  verify,
+  ticket,
+  changeStatus,
+  issueStaffGrant,
+} from "./receptionist/service";
+import { db } from "./db";
+test("verified integration reads remain bound to ticket, conversation and delivered code", async () => {
+  const original = await db.appointment.findFirstOrThrow();
+  const { id, ticketNumber, ...data } = original;
+  void id;
+  void ticketNumber;
+  const t = await db.appointment.create({
+    data: {
+      ...data,
+      status: "CONFIRMED",
+      manageKey: null,
+      customerId: null,
+      portalEligible: true,
+      portalPhone: "+1555" + String(randomInt(1000000, 9999999)),
+    },
+  });
+  let code = "";
+  const ctx = { conversationId: "integration-read", operationId: "read-op" };
+  const c = await challenge(
+    String(t.ticketNumber),
+    ctx,
+    async (_phone, value) => {
+      code = value;
+    },
+  );
+  assert.match(code, /^\d{6}$/);
+  assert.equal((await verify(c.challengeId, "000000", ctx)).ok, false);
+  const v = await verify(c.challengeId, code, ctx);
+  assert.equal(v.ok, true);
+  if (!v.ok) return;
+  const r = await ticket(
+    String(t.ticketNumber),
+    v.value.grant,
+    ctx.conversationId,
+  );
+  assert.equal(r.ok, true);
+  assert.equal(
+    (await ticket(String(t.ticketNumber), v.value.grant, "other-conversation"))
+      .ok,
+    false,
+  );
+  assert.equal((await verify(c.challengeId, code, ctx)).ok, false);
+});
+test("staff cancellations enforce version and atomically audit idempotent writes", async () => {
+  const admin = await db.adminCredential.findUniqueOrThrow({
+    where: { id: 1 },
+  });
+  const grant = await issueStaffGrant({
+    role: "ADMIN",
+    employeeId: null,
+    name: "Admin",
+    sessionVersion: admin.sessionVersion,
+    expires: Date.now() + 600000,
+  });
+  const original = await db.appointment.findFirstOrThrow();
+  const { id, ticketNumber, ...data } = original;
+  void id;
+  void ticketNumber;
+  const t = await db.appointment.create({
+    data: { ...data, status: "CONFIRMED", manageKey: null, customerId: null },
+  });
+  const before = await ticket(String(t.ticketNumber), grant, "staff-session");
+  assert.equal(before.ok, true);
+  if (!before.ok) return;
+  const action = {
+      ticketReference: String(t.ticketNumber),
+      expectedVersion: before.value.version,
+      targetStatus: "CANCELLED",
+      confirmationId: "explicit-test-confirmation",
+    },
+    ctx = {
+      conversationId: "staff-session",
+      operationId: "cancel-test-" + t.id,
+    };
+  const result = await changeStatus(action, grant, ctx);
+  assert.equal(result.ok, true);
+  assert.deepEqual(await changeStatus(action, grant, ctx), result);
+  assert.equal(
+    await db.receptionistRecord.count({
+      where: { id: "operation:" + ctx.operationId, kind: "operation" },
+    }),
+    1,
+  );
+  const record = await db.receptionistRecord.findUniqueOrThrow({
+    where: { id: "operation:" + ctx.operationId },
+  });
+  assert.match(JSON.stringify(record.payload), /oldStatus|CONFIRMED/);
+  assert.equal(
+    (
+      await changeStatus({ ...action, expectedVersion: "stale" }, grant, {
+        ...ctx,
+        operationId: ctx.operationId + "-stale",
+      })
+    ).ok,
+    false,
+  );
+});
+test("booking replay returns original reference after intake revision changes", async () => {
+  const { business, book } = await import("./receptionist/service");
+  const { slots } = await import("./booking");
+  const { randomUUID } = await import("node:crypto");
+  const snapshot = await business(),
+    offering = snapshot.offerings[0],
+    location = snapshot.locations[0];
+  let start: string | undefined;
+  for (let d = 1; d < 8 && !start; d++)
+    start = (
+      await slots(
+        new Date(Date.now() + d * 86400000).toISOString().slice(0, 10),
+        offering.duration,
+        location.id,
+      )
+    )[0];
+  assert.ok(start);
+  const input = {
+      locationId: location.id,
+      offeringId: offering.id,
+      start,
+      firstName: "Replay",
+      lastName: "Test",
+      email: "replay@example.invalid",
+      phone: "+15555550111",
+      issue: "Local test",
+      intakeRevision: snapshot.intakeRevision,
+      answers: Object.fromEntries(
+        snapshot.questions
+          .filter((q) => q.offeringIds.includes(offering.id))
+          .map((q) => [q.id, false]),
+      ),
+      smsConsent: false,
+      confirmationId: "confirmed-replay-test",
+    },
+    context = { conversationId: randomUUID(), operationId: randomUUID() };
+  const initial = await book(input, context);
+  assert.equal(initial.ok, true);
+  const question = await db.preRepairQuestion.findFirstOrThrow();
+  try {
+    await db.preRepairQuestion.update({
+      where: { id: question.id },
+      data: { updatedAt: new Date(Date.now() + 1000) },
+    });
+    assert.deepEqual(await book(input, context), initial);
+  } finally {
+    await db.preRepairQuestion.update({
+      where: { id: question.id },
+      data: { updatedAt: question.updatedAt },
+    });
+  }
+});
