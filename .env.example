# Local fixture mode only. Set real values securely for connected operation.
DATABASE_URL=postgresql://receptionist@127.0.0.1:55432/receptionist
RECEPTIONIST_MODE=fixture
APP_ORIGIN=http://localhost:3000
# Connected mode requires the separate repair-service integration.
REPAIR_SERVICE_URL=
REPAIR_SERVICE_TOKEN=
SESSION_SECRET=
# Provider credentials are configured securely; never put them in browser variables.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Select gemini, openai, or none. An absent selection preserves OpenAI.
AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER_KEY=
VOICE_PUBLIC_ORIGIN=
TRANSFER_NUMBER=
# Hosted fixture demo: set a private six-digit admin PIN or password of at least 16 characters.
# Set APP_ORIGIN to your canonical HTTPS website. Leave password unset only for local development.
DEMO_ADMIN_PASSWORD=
